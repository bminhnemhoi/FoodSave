-- Shared pgTAP helpers + fixture world. NOT a test file (extension .psql is ignored by
-- `supabase test db`); every test includes it right after `begin;` with
--   \ir ../_helpers.psql      (from a sub-directory)   or   \ir _helpers.psql   (from tests/)
-- Everything below lives inside the test transaction and is rolled back with it.
--
-- Roles are simulated like PostgREST does: `role` GUC + `request.jwt.claims` GUC
-- (auth.uid() / auth.jwt() read request.jwt.claims). See TESTING.md §4.1.

create schema tests;

create table tests.ids (name text primary key, id uuid not null);

-- name -> uuid of a fixture row
create function tests.id(p_name text) returns uuid
language sql stable as $$
  select id from tests.ids where name = p_name;
$$;

-- Creates an auth user (=> trigger creates the profile). Run as postgres.
create function tests.create_user(p_name text, p_meta jsonb default '{}'::jsonb) returns uuid
language plpgsql as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (id, email, raw_user_meta_data, aud, role)
  values (v_id, p_name || '@test.local', p_meta, 'authenticated', 'authenticated');
  insert into tests.ids values (p_name, v_id);
  return v_id;
end;
$$;

-- Fixture shortcut only (production uses grant_platform_admin).
create function tests.make_admin(p_name text) returns void
language sql as $$
  update public.profiles set platform_role = 'admin' where id = tests.id(p_name);
$$;

create function tests.create_org(p_name text, p_kind public.org_kind, p_owner text,
                                 p_status public.org_status default 'approved') returns uuid
language plpgsql as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into public.organizations (id, kind, name, slug, subtype, status, submitted_at,
                                    reviewed_by, reviewed_at, rejection_reason, created_by)
  values (v_id, p_kind, 'Org ' || p_name, replace(p_name, '_', '-') || '-' || left(v_id::text, 8),
          case p_kind when 'store' then 'bakery' else 'soup_kitchen' end,
          p_status,
          case when p_status = 'draft' then null else now() end,
          case when p_status in ('approved', 'rejected', 'needs_changes', 'suspended') then tests.id(p_owner) end,
          case when p_status in ('approved', 'rejected', 'needs_changes', 'suspended') then now() end,
          case when p_status in ('rejected', 'needs_changes') then 'fixture' end,
          tests.id(p_owner));
  insert into public.org_members (org_id, user_id, role, status, joined_at)
  values (v_id, tests.id(p_owner), 'owner', 'active', now());
  insert into public.org_sensitive (org_id, legal_name, tax_code, representative_name,
                                    representative_id_last4, contact_email, contact_phone)
  values (v_id, 'Công ty ' || p_name, '0312345678', 'Nguyễn Văn A', '1234',
          p_name || '@org.local', '0901234567');
  insert into tests.ids values (p_name, v_id);
  return v_id;
end;
$$;

create function tests.add_member(p_org text, p_user text, p_role public.org_role,
                                 p_status public.member_status default 'active') returns void
language sql as $$
  insert into public.org_members (org_id, user_id, role, status, joined_at)
  values (tests.id(p_org), tests.id(p_user), p_role, p_status, now());
$$;

create function tests.create_site(p_name text, p_org text,
                                  p_visibility public.site_visibility default 'public',
                                  p_lat float8 default 10.776889, p_lng float8 default 106.700806,
                                  p_active boolean default true) returns uuid
language plpgsql as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into public.sites (id, org_id, name, address_line, ward, location, visibility, is_active)
  values (v_id, tests.id(p_org), 'Site ' || p_name, '12 Hẻm 34 Lê Lợi', 'Phường Bến Thành',
          extensions.st_setsrid(extensions.st_makepoint(p_lng, p_lat), 4326)::extensions.geography,
          p_visibility, p_active);
  insert into tests.ids values (p_name, v_id);
  return v_id;
end;
$$;

-- Role switching (works from any current role because session_user is postgres)
create function tests.authenticate_as(p_name text, p_aal text default 'aal1') returns void
language plpgsql as $$
begin
  perform set_config('role', 'authenticated', true);
  perform set_config('request.jwt.claims',
    jsonb_build_object('sub', tests.id(p_name), 'role', 'authenticated', 'aal', p_aal)::text, true);
end;
$$;

create function tests.as_anon() returns void
language plpgsql as $$
begin
  perform set_config('role', 'anon', true);
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
end;
$$;

create function tests.as_service() returns void
language plpgsql as $$
begin
  perform set_config('role', 'service_role', true);
  perform set_config('request.jwt.claims', '{"role":"service_role"}', true);
end;
$$;

create function tests.clear_auth() returns void
language plpgsql as $$
begin
  perform set_config('role', 'none', true);
  perform set_config('request.jwt.claims', '', true);
end;
$$;

-- Executes a DML statement as the current role and returns the affected row count
-- (RLS-filtered UPDATE/DELETE silently affect 0 rows).
create function tests.affected(p_sql text) returns bigint
language plpgsql as $$
declare
  v_n bigint;
begin
  execute p_sql;
  get diagnostics v_n = row_count;
  return v_n;
end;
$$;

-- Runs p_sql as the current role; returns null when it succeeds, otherwise the error as
-- {"sqlstate", "message", "detail", "hint"} (to assert on PT422 detail / PT429 hint).
create function tests.error_of(p_sql text) returns jsonb
language plpgsql as $$
declare
  v_state text; v_msg text; v_detail text; v_hint text;
begin
  execute p_sql;
  return null;
exception when others then
  get stacked diagnostics v_state = returned_sqlstate, v_msg = message_text,
                          v_detail = pg_exception_detail, v_hint = pg_exception_hint;
  return jsonb_build_object('sqlstate', v_state, 'message', v_msg,
                            'detail', nullif(v_detail, ''), 'hint', nullif(v_hint, ''));
end;
$$;

-- Marks the auth user's email as confirmed (create_organization / accept_invite need it). Run as postgres.
create function tests.confirm_email(p_name text) returns void
language sql as $$
  update auth.users set email_confirmed_at = now() where id = tests.id(p_name);
$$;

grant usage on schema tests to anon, authenticated, service_role;
grant select on tests.ids to anon, authenticated, service_role;
grant execute on all functions in schema tests to anon, authenticated, service_role;

-- ---------------------------------------------------------------------------
-- Fixture world
--   store_a   (approved store)   owner store_owner, manager store_manager, staff store_staff
--   charity_b (approved charity) owner charity_owner, volunteer charity_volunteer
--   store_x   (approved store)   owner other_owner            ("member of another org")
--   draft_c   (draft store)      owner draft_owner            (U: profile owner, not approved)
--   outsider  authenticated user without any org
--   admin     platform admin (test with aal1 and aal2)
--   sites: site_a (store_a, public), site_b (charity_b, approximate), site_x (store_x, hidden),
--          site_c (draft_c, public), site_a_off (store_a, inactive)
-- ---------------------------------------------------------------------------
do $$
begin
  perform tests.create_user(n)
  from unnest(array['store_owner', 'store_manager', 'store_staff', 'charity_owner',
                    'charity_volunteer', 'other_owner', 'draft_owner', 'outsider', 'admin']) as n;
  perform tests.make_admin('admin');

  perform tests.create_org('store_a', 'store', 'store_owner');
  perform tests.add_member('store_a', 'store_manager', 'manager');
  perform tests.add_member('store_a', 'store_staff', 'staff');
  perform tests.create_org('charity_b', 'charity', 'charity_owner');
  perform tests.add_member('charity_b', 'charity_volunteer', 'volunteer');
  perform tests.create_org('store_x', 'store', 'other_owner');
  perform tests.create_org('draft_c', 'store', 'draft_owner', 'draft');

  perform tests.create_site('site_a', 'store_a', 'public');
  perform tests.create_site('site_b', 'charity_b', 'approximate', 10.762622, 106.660172);
  perform tests.create_site('site_x', 'store_x', 'hidden');
  perform tests.create_site('site_c', 'draft_c', 'public');
  perform tests.create_site('site_a_off', 'store_a', 'public', 10.78, 106.70, false);
end;
$$;
