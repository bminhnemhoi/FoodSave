-- Shared pgTAP helpers + fixture world. NOT a test file (extension .psql is ignored by
-- `supabase test db`); every test includes it right after `begin;` with
--   \ir ../_helpers.psql      (from a sub-directory)   or   \ir _helpers.psql   (from tests/)
-- Everything below lives inside the test transaction and is rolled back with it.
--
-- Roles are simulated like PostgREST does: `role` GUC + `request.jwt.claims` GUC
-- (auth.uid() / auth.jwt() read request.jwt.claims). See TESTING.md §4.1.

create schema tests;

create table tests.ids (name text primary key, id uuid not null);

-- name -> uuid of a fixture row
create function tests.id(p_name text) returns uuid
language sql stable as $$
  select id from tests.ids where name = p_name;
$$;

-- Creates an auth user (=> trigger creates the profile). Run as postgres.
create function tests.create_user(p_name text, p_meta jsonb default '{}'::jsonb) returns uuid
language plpgsql as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (id, email, raw_user_meta_data, aud, role)
  values (v_id, p_name || '@test.local', p_meta, 'authenticated', 'authenticated');
  insert into tests.ids values (p_name, v_id);
  return v_id;
end;
$$;

-- Fixture shortcut only (production uses grant_platform_admin).
create function tests.make_admin(p_name text) returns void
language sql as $$
  update public.profiles set platform_role = 'admin' where id = tests.id(p_name);
$$;

create function tests.create_org(p_name text, p_kind public.org_kind, p_owner text,
                                 p_status public.org_status default 'approved') returns uuid
language plpgsql as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into public.organizations (id, kind, name, slug, subtype, status, submitted_at,
                                    reviewed_by, reviewed_at, rejection_reason, created_by)
  values (v_id, p_kind, 'Org ' || p_name, replace(p_name, '_', '-') || '-' || left(v_id::text, 8),
          case p_kind when 'store' then 'bakery' else 'soup_kitchen' end,
          p_status,
          case when p_status = 'draft' then null else now() end,
          case when p_status in ('approved', 'rejected', 'needs_changes', 'suspended') then tests.id(p_owner) end,
          case when p_status in ('approved', 'rejected', 'needs_changes', 'suspended') then now() end,
          case when p_status in ('rejected', 'needs_changes') then 'fixture' end,
          tests.id(p_owner));
  insert into public.org_members (org_id, user_id, role, status, joined_at)
  values (v_id, tests.id(p_owner), 'owner', 'active', now());
  insert into public.org_sensitive (org_id, legal_name, tax_code, representative_name,
                                    representative_id_last4, contact_email, contact_phone)
  values (v_id, 'Công ty ' || p_name, '0312345678', 'Nguyễn Văn A', '1234',
          p_name || '@org.local', '0901234567');
  insert into tests.ids values (p_name, v_id);
  return v_id;
end;
$$;

create function tests.add_member(p_org text, p_user text, p_role public.org_role,
                                 p_status public.member_status default 'active') returns void
language sql as $$
  insert into public.org_members (org_id, user_id, role, status, joined_at)
  values (tests.id(p_org), tests.id(p_user), p_role, p_status, now());
$$;

create function tests.create_site(p_name text, p_org text,
                                  p_visibility public.site_visibility default 'public',
                                  p_lat float8 default 10.776889, p_lng float8 default 106.700806,
                                  p_active boolean default true) returns uuid
language plpgsql as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into public.sites (id, org_id, name, address_line, ward, location, visibility, is_active)
  values (v_id, tests.id(p_org), 'Site ' || p_name, '12 Hẻm 34 Lê Lợi', 'Phường Bến Thành',
          extensions.st_setsrid(extensions.st_makepoint(p_lng, p_lat), 4326)::extensions.geography,
          p_visibility, p_active);
  insert into tests.ids values (p_name, v_id);
  return v_id;
end;
$$;

-- Role switching (works from any current role because session_user is postgres)
create function tests.authenticate_as(p_name text, p_aal text default 'aal1') returns void
language plpgsql as $$
begin
  perform set_config('role', 'authenticated', true);
  perform set_config('request.jwt.claims',
    jsonb_build_object('sub', tests.id(p_name), 'role', 'authenticated', 'aal', p_aal)::text, true);
end;
$$;

create function tests.as_anon() returns void
language plpgsql as $$
begin
  perform set_config('role', 'anon', true);
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
end;
$$;

create function tests.as_service() returns void
language plpgsql as $$
begin
  perform set_config('role', 'service_role', true);
  perform set_config('request.jwt.claims', '{"role":"service_role"}', true);
end;
$$;

create function tests.clear_auth() returns void
language plpgsql as $$
begin
  perform set_config('role', 'none', true);
  perform set_config('request.jwt.claims', '', true);
end;
$$;

-- Executes a DML statement as the current role and returns the affected row count
-- (RLS-filtered UPDATE/DELETE silently affect 0 rows).
create function tests.affected(p_sql text) returns bigint
language plpgsql as $$
declare
  v_n bigint;
begin
  execute p_sql;
  get diagnostics v_n = row_count;
  return v_n;
end;
$$;

-- Runs p_sql as the current role; returns null when it succeeds, otherwise the error as
-- {"sqlstate", "message", "detail", "hint"} (to assert on PT422 detail / PT429 hint).
create function tests.error_of(p_sql text) returns jsonb
language plpgsql as $$
declare
  v_state text; v_msg text; v_detail text; v_hint text;
begin
  execute p_sql;
  return null;
exception when others then
  get stacked diagnostics v_state = returned_sqlstate, v_msg = message_text,
                          v_detail = pg_exception_detail, v_hint = pg_exception_hint;
  return jsonb_build_object('sqlstate', v_state, 'message', v_msg,
                            'detail', nullif(v_detail, ''), 'hint', nullif(v_hint, ''));
end;
$$;

-- Marks the auth user's email as confirmed (create_organization / accept_invite need it). Run as postgres.
create function tests.confirm_email(p_name text) returns void
language sql as $$
  update auth.users set email_confirmed_at = now() where id = tests.id(p_name);
$$;

-- ---------------------------------------------------------------------------
-- P2 helpers (offers / allocations / trips). Functions only: they add no fixture rows unless
-- called, so count-based P0/P1 tests are unaffected.
-- ---------------------------------------------------------------------------

-- Scratch key/value store usable from any role (handover tokens/codes returned once by RPCs).
create table tests.vars (k text primary key, v text);

create function tests.set_var(p_k text, p_v text) returns void
language sql as $$
  insert into tests.vars (k, v) values (p_k, p_v) on conflict (k) do update set v = excluded.v;
$$;

create function tests.var(p_k text) returns text
language sql stable as $$
  select v from tests.vars where k = p_k;
$$;

-- Business clock (private.now() honours fs.clock for session_user postgres, DATA-MODEL §17).
create function tests.set_clock(p_at timestamptz) returns void
language sql as $$
  select set_config('fs.clock', p_at::text, true);
$$;

create function tests.clear_clock() returns void
language sql as $$
  select set_config('fs.clock', '', true);
$$;

-- Fixture shortcut: approve an org (production: review_organization). Run as postgres.
create function tests.approve_org(p_name text) returns void
language sql as $$
  update public.organizations
     set status = 'approved', submitted_at = coalesce(submitted_at, now()),
         reviewed_by = created_by, reviewed_at = now(), rejection_reason = null
   where id = tests.id(p_name);
$$;

-- Fixture shortcut: an offer row inserted directly (status open by default, effective_deadline =
-- least(expires_at, window end) — fixture sites have no hours = 24/7). Run as postgres.
create function tests.make_offer(
  p_name         text,
  p_site         text default 'site_a',
  p_category     text default 'bread',
  p_qty          numeric default 10,
  p_window_start timestamptz default now() - interval '10 minutes',
  p_window_end   timestamptz default now() + interval '5 hours',
  p_expires_at   timestamptz default now() + interval '1 day',
  p_status       public.offer_status default 'open',
  p_unit         public.unit_code default null,
  p_unit_weight  numeric default null
) returns uuid
language plpgsql as $$
declare
  v_id    uuid := gen_random_uuid();
  v_org   uuid;
  v_owner uuid;
begin
  select s.org_id into v_org from public.sites s where s.id = tests.id(p_site);
  select m.user_id into v_owner from public.org_members m where m.org_id = v_org and m.role = 'owner' limit 1;
  insert into public.offers (id, org_id, site_id, category_code, title, quantity, unit, unit_weight_kg,
                             expires_at, pickup_window, status, effective_deadline, published_at,
                             safety_attested_at, safety_attested_by, created_by)
  values (v_id, v_org, tests.id(p_site), p_category, 'Lô ' || p_name, p_qty,
          coalesce(p_unit, (select c.default_unit from public.food_categories c where c.code = p_category)),
          p_unit_weight, p_expires_at, tstzrange(p_window_start, p_window_end, '[)'), p_status,
          case when p_status <> 'draft' then least(p_expires_at, p_window_end) end,
          case when p_status <> 'draft' then now() end,
          case when p_status <> 'draft' then now() end,
          case when p_status <> 'draft' then v_owner end,
          v_owner);
  insert into tests.ids values (p_name, v_id);
  return v_id;
end;
$$;

-- request_offer as p_user; returns the allocation id (auth cleared afterwards).
create function tests.request(p_user text, p_offer uuid, p_qty numeric, p_site text default 'site_b')
returns uuid
language plpgsql as $$
declare
  v jsonb;
begin
  perform tests.authenticate_as(p_user);
  v := public.request_offer(p_offer, p_qty, tests.id(p_site), gen_random_uuid());
  perform tests.clear_auth();
  return (v ->> 'allocation_id')::uuid;
end;
$$;

create function tests.confirm(p_user text, p_allocation uuid) returns void
language plpgsql as $$
begin
  perform tests.authenticate_as(p_user);
  perform public.confirm_allocation(p_allocation, gen_random_uuid());
  perform tests.clear_auth();
end;
$$;

-- assign_pickup (self pickup by default) as p_user for the given allocations; returns pickup id.
create function tests.pickup(p_user text, p_allocations uuid[], p_site text default 'site_b',
                             p_mode text default 'self', p_assignee text default null)
returns uuid
language plpgsql as $$
declare
  v uuid;
begin
  perform tests.authenticate_as(p_user);
  v := public.assign_pickup(jsonb_build_object(
         'allocation_ids', to_jsonb(p_allocations), 'mode', p_mode, 'charity_site_id', tests.id(p_site),
         'assignee_user_id', tests.id(p_assignee)), gen_random_uuid());
  perform tests.clear_auth();
  return v;
end;
$$;

create function tests.stop_of(p_allocation uuid) returns uuid
language sql stable as $$
  select stop_id from public.allocations where id = p_allocation;
$$;

create function tests.dropoff_stop(p_pickup uuid) returns uuid
language sql stable as $$
  select id from public.pickup_stops where pickup_id = p_pickup and kind = 'dropoff';
$$;

-- issue_handover_token as p_user; stores token/code/handover id under p_key_* in tests.vars.
create function tests.issue(p_user text, p_stop uuid, p_key text default 'h') returns uuid
language plpgsql as $$
declare
  r record;
begin
  perform tests.authenticate_as(p_user);
  select * into r from public.issue_handover_token(p_stop, '[]'::jsonb, gen_random_uuid());
  perform tests.clear_auth();
  perform tests.set_var(p_key || '_token', r.token);
  perform tests.set_var(p_key || '_code', r.code);
  perform tests.set_var(p_key || '_id', r.handover_id::text);
  return r.handover_id;
end;
$$;

-- Full lines for a pickup stop / dropoff: [{allocation_id, qty = expected}].
create function tests.full_lines(p_stop uuid) returns jsonb
language sql stable as $$
  select coalesce(jsonb_agg(jsonb_build_object('allocation_id', a.id,
           'qty', case when s.kind = 'pickup' then a.qty_reserved - a.qty_released else a.qty_picked end)
           order by a.id), '[]'::jsonb)
  from public.pickup_stops s
  join public.allocations a
    on (s.kind = 'pickup' and a.stop_id = s.id and a.status = 'assigned')
    or (s.kind = 'dropoff' and a.pickup_id = s.pickup_id and a.status = 'picked_up')
  where s.id = p_stop;
$$;

grant usage on schema tests to anon, authenticated, service_role;
-- tests may capture an RPC result as the calling role (create table tests.x as select ...); rolled back.
grant create on schema tests to authenticated;
grant select on tests.ids to anon, authenticated, service_role;
grant select, insert, update on tests.vars to anon, authenticated, service_role;
grant execute on all functions in schema tests to anon, authenticated, service_role;

-- ---------------------------------------------------------------------------
-- Fixture world
--   store_a   (approved store)   owner store_owner, manager store_manager, staff store_staff
--   charity_b (approved charity) owner charity_owner, volunteer charity_volunteer
--   store_x   (approved store)   owner other_owner            ("member of another org")
--   draft_c   (draft store)      owner draft_owner            (U: profile owner, not approved)
--   outsider  authenticated user without any org
--   admin     platform admin (test with aal1 and aal2)
--   sites: site_a (store_a, public), site_b (charity_b, approximate), site_x (store_x, hidden),
--          site_c (draft_c, public), site_a_off (store_a, inactive)
-- ---------------------------------------------------------------------------
do $$
begin
  perform tests.create_user(n)
  from unnest(array['store_owner', 'store_manager', 'store_staff', 'charity_owner',
                    'charity_volunteer', 'other_owner', 'draft_owner', 'outsider', 'admin']) as n;
  perform tests.make_admin('admin');

  perform tests.create_org('store_a', 'store', 'store_owner');
  perform tests.add_member('store_a', 'store_manager', 'manager');
  perform tests.add_member('store_a', 'store_staff', 'staff');
  perform tests.create_org('charity_b', 'charity', 'charity_owner');
  perform tests.add_member('charity_b', 'charity_volunteer', 'volunteer');
  perform tests.create_org('store_x', 'store', 'other_owner');
  perform tests.create_org('draft_c', 'store', 'draft_owner', 'draft');

  perform tests.create_site('site_a', 'store_a', 'public');
  perform tests.create_site('site_b', 'charity_b', 'approximate', 10.762622, 106.660172);
  perform tests.create_site('site_x', 'store_x', 'hidden');
  perform tests.create_site('site_c', 'draft_c', 'public');
  perform tests.create_site('site_a_off', 'store_a', 'public', 10.78, 106.70, false);
end;
$$;

-- ---------------------------------------------------------------------------
-- P3 helpers (needs / bundles / volunteer trips). Functions only: no fixture rows unless called.
-- ---------------------------------------------------------------------------

-- Fixture shortcut: a need inserted directly (status open; the trigger checks site/categories).
-- Run as postgres. Default: charity_b at site_b, 50 loaves of bread, needed in 1 day.
create function tests.make_need(
  p_name       text,
  p_site       text default 'site_b',
  p_categories text[] default '{bread}',
  p_unit       public.unit_code default 'loaf',
  p_qty        numeric default 50,
  p_needed_by  timestamptz default now() + interval '1 day'
) returns uuid
language plpgsql as $$
declare
  v_id    uuid := gen_random_uuid();
  v_org   uuid;
  v_owner uuid;
begin
  select s.org_id into v_org from public.sites s where s.id = tests.id(p_site);
  select m.user_id into v_owner from public.org_members m where m.org_id = v_org and m.role = 'owner' limit 1;
  insert into public.needs (id, org_id, site_id, category_codes, unit, quantity, needed_by, created_by)
  values (v_id, v_org, tests.id(p_site), p_categories, p_unit, p_qty, p_needed_by, v_owner);
  insert into tests.ids values (p_name, v_id);
  return v_id;
end;
$$;

-- reserve_bundle as p_user with p_lines = [[offer_name, qty], ...]; returns the RPC result.
create function tests.reserve(p_user text, p_need uuid, p_lines jsonb, p_meta jsonb default '{}'::jsonb)
returns jsonb
language plpgsql as $$
declare
  v jsonb;
begin
  perform tests.authenticate_as(p_user);
  v := public.reserve_bundle(p_need,
         (select jsonb_agg(jsonb_build_object('offer_id', tests.id(x ->> 0), 'qty', (x ->> 1)::numeric))
          from jsonb_array_elements(p_lines) x),
         gen_random_uuid(), p_meta);
  perform tests.clear_auth();
  return v;
end;
$$;

-- Active location_trip consent for p_user (fixture shortcut; production: grant_consent). Run as postgres.
create function tests.grant_location(p_user text) returns void
language sql as $$
  insert into public.consents (user_id, purpose, policy_version, source, text_hash)
  values (tests.id(p_user), 'location_trip', '2026-10-v1', 'web', repeat('a', 64));
$$;

-- A one-lot volunteer trip at site_a for charity_b: lot p_offer_name (bread, qty 10), allocation of
-- p_qty confirmed, assigned to charity_volunteer. Returns the pickup id; the allocation is stored as
-- tests.var(p_offer_name || '_alloc').
create function tests.volunteer_trip(p_offer_name text, p_qty numeric default 4) returns uuid
language plpgsql as $$
declare
  v_alloc uuid;
begin
  perform tests.make_offer(p_offer_name, 'site_a', 'bread', 10);
  v_alloc := tests.request('charity_owner', tests.id(p_offer_name), p_qty);
  perform tests.confirm('store_staff', v_alloc);
  perform tests.set_var(p_offer_name || '_alloc', v_alloc::text);
  return tests.pickup('charity_owner', array[v_alloc], 'site_b', 'volunteer', 'charity_volunteer');
end;
$$;

grant execute on all functions in schema tests to anon, authenticated, service_role;
