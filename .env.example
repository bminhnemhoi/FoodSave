# FoodSave v2 — mẫu biến môi trường. Sao chép thành .env.local (KHÔNG commit file thật).
# Chi tiết từng biến: docs/DEPLOYMENT.md. NEXT_PUBLIC_* sẽ lộ ra trình duyệt — chỉ đặt giá trị công khai.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local            # local | staging | production
FEATURE_AI=false                     # bật tính năng AI (ảnh → tự điền lô, kiểm minh chứng, nhận xét ESG)
FEATURE_WEB_PUSH=false
MAINTENANCE_MODE=false               # bật trang bảo trì khi cần khắc phục sự cố
NEXT_PUBLIC_APP_VERSION=0.0.0        # CI gán theo tag khi build

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # CHỈ dùng trong src/server — không bao giờ NEXT_PUBLIC
SUPABASE_STAGING_PROJECT_REF=        # dùng cho Supabase MCP (read-only) trong .mcp.json
SUPABASE_PROD_PROJECT_REF=
SUPABASE_DB_URL=                     # CHỈ cho script seed/lịch sử (scripts/), không dùng trong app
JOBS_HMAC_SECRET=                    # ký request pg_net → /api/jobs/dispatch (openssl rand -hex 32); trùng secret Vault jobs_hmac_secret của project (DEPLOYMENT §4.4)
IP_HASH_SECRET=                      # băm IP trong audit/rate limit (không lưu IP thô)

# --- Bản đồ (provider: goong | ors | aws | fake[test/CI]) ---
MAPS_PROVIDER=goong
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="FoodSave/1.0 (<email liên hệ>)"
NEXT_PUBLIC_GOONG_MAPTILES_KEY=      # key tile (giới hạn theo domain)
GOONG_API_KEY=                       # key REST (geocode, directions, distance matrix) — server only
ORS_API_KEY=                         # dự phòng OpenRouteService
NEXT_PUBLIC_MAP_STYLE_FALLBACK=https://tiles.openfreemap.org/styles/liberty

# --- AI (provider: openai | anthropic | bedrock | fake) — ADR-010 ---
AI_PROVIDER=openai
OPENAI_API_KEY=                      # server only
AI_MODEL=gpt-5.4-mini                # ảnh + trích xuất JSON
AI_MODEL_LIGHT=gpt-5.4-nano          # văn bản nhẹ
ANTHROPIC_API_KEY=                   # tùy chọn (provider thay thế)
AWS_REGION=ap-southeast-1            # dùng khi AI_PROVIDER=bedrock / dịch vụ AWS sau này

# --- Thông báo (provider: smtp | resend | ses) — ADR-011: chưa có domain → Gmail SMTP ---
NOTIFY_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=                           # Gmail gửi thư (vd. Gmail của chủ dự án)
SMTP_PASS=                           # App Password 16 ký tự của Gmail đó (viết liền)
RESEND_API_KEY=                      # khi có domain
EMAIL_FROM=                          # để trống ⇒ "FoodSave <SMTP_USER>"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                       # mailto:<email liên hệ>

# --- Quan sát ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
AUTH_RATE_LIMIT_MULTIPLIER=1                 # chỉ E2E đặt cao hơn; production luôn 1
